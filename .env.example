# Nome exibido no portal e na documentação
APP_NAME=ContrataAPI
# SQLite para desenvolvimento; em produção use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/contrata
DATABASE_URL=sqlite:///./contrata.db
# Requisições por minuto permitidas para cada chave
RATE_LIMIT_PER_MINUTE=60
